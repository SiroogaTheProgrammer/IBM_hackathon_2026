Bogazici_cleaned
main_trainset

# Parquet datasets - processed corpora, regenerated from the raw data
*.parquet

# --- Raw/derived training data & caches -------------------------------------
# These are large (tens of GB across the repo) and are only needed locally to
# retrain models - the deployed demo-site only needs the small exported JSON
# weight files under demo-site/src/lib/biometrics/model/. Keeping these
# tracked in git bloated the repo's packed size to multiple GB, which made
# Vercel's git clone/build step fail. Ignoring them here does NOT delete the
# files from disk - only stops them from being tracked/cloned going forward.
Keystrokes/
training_files/
test_files/
encoder2/
encoder3/
# Feature-window caches (regenerated by train_base_model.py, can be
# hundreds of MB to multi-GB) - NOT the small trained model artifacts
# (encoder.pt, base_model.json, scaler.npz, background_*.npy) which stay
# tracked at the top level of artifacts/.
artifacts/cache/
.cache_train.npz


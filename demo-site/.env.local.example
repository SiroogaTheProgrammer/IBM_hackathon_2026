# Copy to .env.local to point the app at the local Redis from docker-compose.yml:
#
#   cp .env.local.example .env.local
#   docker compose up -d
#
# In production these two are injected by the Vercel Upstash integration
# (project Storage tab -> Marketplace -> Upstash for Redis).
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local_dev_token
